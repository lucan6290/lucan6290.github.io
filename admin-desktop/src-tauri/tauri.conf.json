{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "箓川码笺管理端",
  "version": "0.1.0",
  "identifier": "cn.xiaocancoding.admin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:14200",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "箓川码笺管理端",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "箓川码笺内容管理桌面端",
    "longDescription": "箓川码笺个人技术站与知识库系统的桌面端管理应用"
  },
  "plugins": {}
}
