# ============================================================
# admin-desktop .gitignore
# 核心：密钥/敏感文件兜底，防止泄露到开源仓库
# ============================================================

# 密钥与签名文件（签名私钥的硬保障，勿删）
*.key
*.key.pub

# 依赖
node_modules/

# 环境变量与敏感配置
.env
.env.*
!.env.example

# 构建产物
dist/
*.local
*.tsbuildinfo

# Tauri / Rust
src-tauri/target/
src-tauri/gen/
src-tauri/.bundle/

# 编辑器 / IDE
.idea/
.vscode/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
