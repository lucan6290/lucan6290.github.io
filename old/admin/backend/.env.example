# Copy this file to admin/backend/.env on your server or local machine.
# Do not commit the real .env file.

LUCHUAN_ENV=production
LUCHUAN_ADMIN_USERNAME=admin
LUCHUAN_ADMIN_PASSWORD=change-this-to-a-long-random-password
LUCHUAN_AUTH_SECRET=change-this-to-a-different-long-random-secret
LUCHUAN_AUTH_TOKEN_TTL_MINUTES=720

# Keep this aligned with the public origin that serves the admin frontend.
# Local development:
# LUCHUAN_CORS_ORIGINS=http://127.0.0.1:14000,http://localhost:14000
# Production example:
# LUCHUAN_CORS_ORIGINS=https://your-domain.com
